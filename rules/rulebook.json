{
  "rulebook_version": "2026.10.02-r1",
  "rules": [
    {
      "rule": "burst_small_pay",
      "rule_version": "1.0.0",
      "description": "同一账号在滑动窗口内，于该账号从未出现过的 IP 地区连续发生多笔小额支付（设备农场/盗卡批量扣款）",
      "window_seconds": 60,
      "thresholds": {
        "min_pay_count": 12,
        "max_amount": 500,
        "require_unseen_region": true
      },
      "window_compare": "span_seconds < window_seconds",
      "aggregations": ["pay_count", "amount_sum", "amount_max"]
    },
    {
      "rule": "new_device_big_withdraw",
      "rule_version": "1.0.0",
      "description": "账号在一台从未使用过的设备上登录，随后在关联窗口内于同一设备发起大额提现（新机大额提现）",
      "window_seconds": 300,
      "thresholds": {
        "min_withdraw_amount": 10000,
        "require_same_device": true,
        "require_prior_login": true
      },
      "window_compare": "withdraw_ts - login_ts <= window_seconds",
      "aggregations": ["withdraw_amount", "login_withdraw_gap_seconds"]
    }
  ]
}
